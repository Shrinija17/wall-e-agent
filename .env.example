# Discord — get token from Discord Developer Portal, channel ID by right-clicking channel
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=                    # #wall-e — main chat
DISCORD_BRIEFINGS_CHANNEL_ID=          # #briefings — morning briefings
DISCORD_DRAFTS_CHANNEL_ID=             # #drafts — post approvals

# AI APIs
GROQ_API_KEY=              # Free from https://console.groq.com/keys
TAVILY_API_KEY=

# Database — Railway provides this for PostgreSQL; leave blank for local SQLite
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Scheduling
TIMEZONE=America/New_York
MORNING_BRIEF_CRON=0 9 * * *
